{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tallyhand",
  "version": "0.3.2",
  "description": "Contractor time tracking, invoicing and financial records with guided agent workflows.",
  "author": {
    "name": "Preetham Kyanam"
  },
  "homepage": "https://tallyhand.xyz",
  "repository": "https://github.com/pkyanam/tallyhand",
  "license": "MIT",
  "keywords": [
    "contractors",
    "invoices",
    "timesheets",
    "finance"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Tallyhand",
        "shortDescription": "Time tracking and invoicing for independent contractors",
        "longDescription": "Manage contractor work, clients, projects, invoices and financial records through Tallyhand. Includes guided workflows and account-scoped tools.",
        "developerName": "Preetham Kyanam",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://tallyhand.xyz",
        "defaultPrompt": [
          "Set up my contractor workspace",
          "Review my unbilled work",
          "Prepare a client invoice draft"
        ],
        "brandColor": "#111827",
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}
